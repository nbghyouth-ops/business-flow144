# Runtime database connection. Server-only; never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Transactional email. Required in production for register, password reset and invitations.
# Local development may omit SMTP: OTP/invite links are exposed only as dev headers/logs.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=replace-with-secret
SMTP_FROM=noreply@example.com

# Public canonical URL used to build invitation links. Example: https://app.example.com
NEXT_PUBLIC_APP_URL=https://your-domain.example

# CRON_SECRET is generated and stored in Vercel Production by:
# npm run vercel:cron-secret
# Do not commit a real value here.

# Optional local cron test only (generate a strong value yourself; never commit it):
# CRON_SECRET=
